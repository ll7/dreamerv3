#!/bin/bash

#SBATCH --job-name=dreamerv3
#SBATCH --account=mitarbeiter
#SBATCH --partition=a30
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24          # Increased for better performance
#SBATCH --mem=128G                  # Increased for larger models
#SBATCH --gres=gpu:a30:1
#SBATCH --time=24:00:00           # Increased for longer training
#SBATCH --qos=a30-gpu
#SBATCH --output=slurm-%j.out     # Add output logging
#SBATCH --error=slurm-%j.err      # Add error logging

# Error handling
set -e
trap 'echo "Job failed at line $LINENO"' ERR

# Setup environment
echo "Job started at $(date)"
echo "Running on node: $HOSTNAME"
nvidia-smi                        # Log GPU info

# Create log directory
LOGDIR="logs/run_$(date +%Y%m%d_%H%M%S)"
mkdir -p $LOGDIR

# Run installation
./install.sh 2>&1 | tee "$LOGDIR/install.log" || {
    echo "Installation failed"
    exit 1
}

# Run training
./train.sh 2>&1 | tee "$LOGDIR/train.log" || {
    echo "Training failed"
    exit 1
}

# Cleanup and summary
echo "Job completed at $(date)"
echo "Logs saved in $LOGDIR"